<?xml version="1.0" encoding="UTF-8"?>
<OfficeApp xmlns="http://schemas.microsoft.com/office/appforoffice/1.1" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="TaskPaneApp">
  <Id>1c5f7f1a-7a5f-4a2a-9b2e-0f1e6e7a0001</Id>
  <Version>1.0.0.0</Version>
  <ProviderName>RAMA</ProviderName>
  <DefaultLocale>en-US</DefaultLocale>
  <DisplayName DefaultValue="RAMA Excel Add-in" />
  <Description DefaultValue="Real-time control of Excel from RAMA chat" />
  <IconUrl DefaultValue="https://localhost/icon-32.png" />
  <HighResolutionIconUrl DefaultValue="https://localhost/icon-80.png" />
  <SupportUrl DefaultValue="https://example.com" />
  <AppDomains>
    <AppDomain>http://127.0.0.1:4300</AppDomain>
    <AppDomain>https://appsforoffice.microsoft.com</AppDomain>
  </AppDomains>
  <Hosts>
    <Host Name="Workbook" />
  </Hosts>
  <DefaultSettings>
    <SourceLocation DefaultValue="http://127.0.0.1:4300/panel.html" />
  </DefaultSettings>
  <Permissions>ReadWriteDocument</Permissions>
  <VersionOverrides xmlns="http://schemas.microsoft.com/office/taskpaneappversionoverrides" xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0">
    <Hosts>
      <Host xsi:type="Workbook">
        <DesktopFormFactor>
          <GetStarted>
            <Title resid="residGetStartedTitle" />
            <Description resid="residGetStartedDesc" />
            <LearnMoreUrl resid="residLearnMoreUrl" />
          </GetStarted>
          <FunctionFile resid="residFunctionFile" />
          <ExtensionPoint xsi:type="PrimaryCommandSurface">
            <OfficeTab id="TabHome">
              <Group id="Rama.Group" label="RAMA Add-in" icon="">
                <Control xsi:type="Button" id="Rama.TaskPaneButton">
                  <Label resid="residTaskPaneButtonLabel" />
                  <Supertip>
                    <Title resid="residTaskPaneButtonTitle" />
                    <Description resid="residTaskPaneButtonDesc" />
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="icon16" xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0" />
                  </Icon>
                  <Action xsi:type="ShowTaskpane">
                    <SourceLocation resid="residTaskPaneUrl" />
                  </Action>
                </Control>
              </Group>
            </OfficeTab>
          </ExtensionPoint>
          <Taskpane id="Rama.TaskPane">
            <SourceLocation resid="residTaskPaneUrl" />
          </Taskpane>
        </DesktopFormFactor>
      </Host>
    </Hosts>
    <Resources>
      <bt:Images xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0">
        <bt:Image id="icon16" DefaultValue="https://localhost/icon-16.png" />
      </bt:Images>
      <bt:Urls xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0">
        <bt:Url id="residTaskPaneUrl" DefaultValue="http://127.0.0.1:4300/panel.html" />
        <bt:Url id="residFunctionFile" DefaultValue="http://127.0.0.1:4300/panel.html" />
        <bt:Url id="residLearnMoreUrl" DefaultValue="https://example.com" />
      </bt:Urls>
      <bt:ShortStrings xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0">
        <bt:String id="residTaskPaneButtonLabel" DefaultValue="RAMA" />
        <bt:String id="residTaskPaneButtonTitle" DefaultValue="Abrir panel RAMA" />
        <bt:String id="residGetStartedTitle" DefaultValue="RAMA" />
      </bt:ShortStrings>
      <bt:LongStrings xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0">
        <bt:String id="residTaskPaneButtonDesc" DefaultValue="Controla Excel desde la app RAMA." />
        <bt:String id="residGetStartedDesc" DefaultValue="Abra el panel RAMA para sincronizar con el chat." />
      </bt:LongStrings>
    </Resources>
  </VersionOverrides>
</OfficeApp>


