{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ListDocsRow",
  "type": "object",
  "required": ["document_group", "document_name"],
  "properties": {
    "document_group": {"type": "string", "minLength": 1},
    "document_subgroup": {"type": "string"},
    "document_name": {"type": "string", "minLength": 1},
    "storage_key": {"type": ["string", "null"]},
    "metadata": {"type": ["object", "null"]},
    "document_kind": {"type": ["string", "null"], "enum": ["document", "factura", null]},
    "parent_document_id": {"type": ["string", "null"]},
    "due_date": {"type": ["string", "null"], "description": "ISO date for factura placeholders"},
    "placeholder": {"type": ["boolean", "null"]},
    "auto_generated": {"type": ["boolean", "null"]}
  }
}

